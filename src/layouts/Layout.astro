---
import "../styles/style.css";

interface Props {
  title?: string;
}

const { title = "サイト" } = Astro.props;
---

<!doctype html>
<html lang="ja">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
</head>
<body>
    <div class="header">
        <p>
            <a href="/" class="header-text">わゆちゃんのホームページ</a></p>
    </div>
    <div class="main">
        <div class="content">
            <slot />
        </div>
    </div>
    <div class="footer">
        <p class="tiisaku">Copyright &#40;C&#41; 2026 わゆちゃん All rights reserved.</p>
    </div>
</body>
</html>