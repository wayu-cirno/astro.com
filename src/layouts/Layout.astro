---
import "../styles/style.css";
import siteConfig from "../data/index.json";

interface Props {
  title?: string;
}

const { title = "サイト" } = Astro.props;

const menu = Array.isArray(siteConfig?.menu) ? siteConfig.menu : [];
---

<!doctype html>
<html lang="ja">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
</head>
<body>
    <div class="site">
<div class="header">
        <p>
            <a href="/" class="header-text">わゆちゃんのホームページ</a></p>
    </div>
<div class="main">
        <div class="content">
            <slot />
        </div>

        <div class="sidebar">
            <div class="sidebar-menu">
                {menu.map((item) => (
                    <p>
                        <a href={item.url} class="s">{item.title}</a>
                    </p>
                ))}
            </div>
        </div>
</div>
<div class="footer">
        <p class="tiisaku">Copyright &#40;C&#41; 2026 わゆちゃん All rights reserved.</p>
    </div>
</div>
</body>
</html>
    <div class="footer">
        <p class="tiisaku">Copyright &#40;C&#41; 2026 わゆちゃん All rights reserved.</p>
    </div>
</body>
</html>
