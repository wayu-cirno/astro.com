---
import "../styles/style.css";
import { existsSync, readFileSync } from "node:fs";
import { parse } from "yaml";

interface Props {
  title?: string;
}

const { title = "サイト" } = Astro.props;

const menuPath = new URL("../content/pages/index.yml", import.meta.url);

const siteConfig = existsSync(menuPath)
  ? parse(readFileSync(menuPath, "utf-8"))
  : {};

const menu = Array.isArray(siteConfig?.menu) ? siteConfig.menu : [];
---

<!doctype html>
<html lang="ja">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
</head>
<body>
    <div class="header">
        <p>
            <a href="/" class="header-text">わゆちゃんのホームページ</a></p>
    </div>
    <div class="main">
        <div class="content">
            <slot />
        </div>

        <div class="sidebar">
            <p class="sidebar-title">サイトメニュー</p>
            <ul>
                {menu.map((item) => (
                    <li>
                        <a href={item.url}>{item.title}</a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
    <div class="footer">
        <p class="tiisaku">Copyright &#40;C&#41; 2026 わゆちゃん All rights reserved.</p>
    </div>
</body>
</html>